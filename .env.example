# ── Serveur ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Base de données PostgreSQL ────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=senegal_connect
DB_USER=postgres
DB_PASS=mets_ici_ton_vrai_mot_de_passe_postgres

# ── JWT ──────────────────────────────────────────────────────────────
JWT_SECRET=mets_ici_un_secret_aleatoire_de_64_caracteres_minimum
JWT_EXPIRES_IN=24h

# ── CORS ───────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Logs ───────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Upload ─────────────────────────────────────────────────────────────
MAX_FILE_SIZE=10485760

# ── Facturation ──────────────────────────────────────────────────────
CRON_TIMEZONE=Africa/Dakar

